# Copy to .env and edit. Wallet keys live only in secrets/wallets.json.

# --- Safety -------------------------------------------------------------
# 0 = DRY (default): detect, gate, simulate/log; never sendRawTransaction.
# 1 = live buys. Never sell.
SNIPER_LIVE=0

# --- RPC ----------------------------------------------------------------
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
RPC_WSS=wss://robinhood.drpc.org
RPC_HTTP_FALLBACK=https://robinhood.drpc.org

# --- Sniper sizing / caps -----------------------------------------------
# Whole tokens to buy (raw = SNIPER_TOKENS * 10**decimals).
SNIPER_TOKENS=100000
# Max quote raw units per buy (USDG 6dp: 50000000 = 50 USDG). ETH 18dp: use wei.
MAX_QUOTE_IN=
# Max quote raw units spent per UTC day (same units as MAX_QUOTE_IN).
DAILY_MAX_QUOTE=
SLIPPAGE_BPS=300
# Delay before send (ms). Snipe tax starts ~99% and decays over ~3s; default 0 = max speed.
SNIPER_DELAY_MS=0
# 1 = skip cbBTC/WETH quote pairs (default). 0 = allow.
SKIP_INELIGIBLE_QUOTES=1
# Floor for ETH kept for gas after cover (wei). Preflight uses
# max(this, gasUnits×maxFeePerGas) for swap/approve/buy. Default 0.0001 ETH.
GAS_RESERVE_WEI=100000000000000

# --- Watcher / holders --------------------------------------------------
HOLDER_DUST=1
NETWORTH_INTERVAL_MS=30000
POT_REFRESH_MS=15000

# --- Read-only observe (other machine’s sniper) -------------------------
# Set to a sniper address to run watcher+dash with NO private key / NO buys.
# Discovers CurveBuy for that wallet into a local DB for the dashboard.
# READ_ADDRESS=0xYourSniperAddress
# Optional separate DB so it doesn’t clash with a local sniper DB:
# DB_PATH=data/pons-read.db
# How far back to scan on first sync (~0.1s/block; default 1e6 ≈ 28h).
# READ_LOOKBACK_BLOCKS=1000000

# --- Storage / dash -----------------------------------------------------
DB_PATH=data/pons.db
DASH_HOST=127.0.0.1
DASH_PORT=42100
