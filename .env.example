# Copy to .env and edit. Wallet keys live only in secrets/wallets.json.

# --- Safety -------------------------------------------------------------
# 0 = DRY (default): detect, gate, simulate/log; never sendRawTransaction.
# 1 = live buys. Never sell.
SNIPER_LIVE=0
# --- RPC ----------------------------------------------------------------
# Prefer the pool (comma-separated). Order = priority; viem tries the next on failure.
# Defaults already include official + dRPC + PublicNode + bloXroute + others.
# RPC_HTTP_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.drpc.org,https://robinhood-rpc.publicnode.com,https://rpc-robinhood.blockmachine.io,https://robinhood.rpc.blxrbdn.com
# RPC_WSS_URLS=wss://robinhood.drpc.org,wss://robinhood-rpc.publicnode.com
# Or keep the legacy pair (merged into the default pool):
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
RPC_WSS=wss://robinhood.drpc.org
RPC_HTTP_FALLBACK=https://robinhood.drpc.org
# Extra endpoints appended to the default pool (optional):
# RPC_HTTP_EXTRA=
# RPC_WSS_EXTRA=

# --- Sniper sizing / caps -----------------------------------------------
# Whole tokens to buy (raw = SNIPER_TOKENS * 10**decimals).
SNIPER_TOKENS=100000
# Max quote raw units per buy (USDG 6dp: 50000000 = 50 USDG). ETH 18dp: use wei.
MAX_QUOTE_IN=
# Max quote raw units spent per UTC day (same units as MAX_QUOTE_IN).
DAILY_MAX_QUOTE=
SLIPPAGE_BPS=300
# Delay before send (ms). Snipe tax starts ~99% and decays over ~3s.
# Default 3000 = wait out the tax. Set 0 only if you accept paying snipe tax for speed.
SNIPER_DELAY_MS=3000
# Boot catch-up + max launch age (blocks ≈ 0.1s). Default 900 ≈ 90s. Older = skip stale_launch.
# SNIPER_CATCHUP_BLOCKS=900
# 1 = skip cbBTC/WETH quote pairs (default). 0 = allow.
SKIP_INELIGIBLE_QUOTES=1
# Floor for ETH kept for gas after cover (wei). Preflight uses
# max(this, gasUnits×maxFeePerGas) for swap/approve/buy. Default 0.0001 ETH.
GAS_RESERVE_WEI=100000000000000

# --- Watcher / holders --------------------------------------------------
HOLDER_DUST=1
NETWORTH_INTERVAL_MS=30000
POT_REFRESH_MS=15000

# --- Read-only observe (other machine’s sniper) -------------------------
# Shared-repo safe: does NOT disable sniper when secrets/wallets.json exists.
# Sniper machine: npm run sniper / npm start (uses local key).
# Dash machine:   npm run observe (uses READ_ADDRESS, no key needed).
# READ_ADDRESS=0xYourSniperAddress
# Optional separate DB on the dash machine:
# DB_PATH=data/pons-read.db
# How far back to scan on first sync (~0.1s/block; default 1e6 ≈ 28h).
# READ_LOOKBACK_BLOCKS=1000000
# OBSERVE_RECHECK_BLOCKS=100000   # tick re-scan of recent launches (~3h)
# BLOCKSCOUT_API=https://robinhoodchain.blockscout.com
# BLOCKSCOUT_API_KEY=             # optional; helps observe find old follow bags
# PONS_APP_BASE=https://ponsfamily.com/launchpad
# EXPLORER_BASE=https://robinhoodchain.blockscout.com

# --- Farmer-follow (piggyback) — independent of SNIPER_LIVE -------------
# Follow known fee-farmers into pools they hold; ~$0.80 bag; hold forever.
# 0 = DRY (default): detect → gate → would-buy; never sendRawTransaction.
FOLLOW_LIVE=0
FOLLOW_BUY_USD=0.8
FOLLOW_MAX_OPEN=40
FOLLOW_DAILY_USD=40
# Boot Transfer lookback (blocks ≈ 0.1s). Default 50k ≈ 1.4h.
# FOLLOW_LOOKBACK_BLOCKS=50000
# Extra farmer addresses (comma/space), merged with built-in known set.
# FOLLOW_FARMERS=
# Delay before follow buy (ms). Default 0 (pools usually past snipe tax).
# FOLLOW_DELAY_MS=0

# --- Storage / dash -----------------------------------------------------
DB_PATH=data/pons.db
DASH_HOST=127.0.0.1
DASH_PORT=42100
